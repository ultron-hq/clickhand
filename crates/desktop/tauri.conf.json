{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultron",
  "identifier": "app.ultron.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "island", "url": "island.html", "title": "Ultron",
        "width": 236, "height": 52, "resizable": false, "decorations": false,
        "transparent": true, "alwaysOnTop": true, "skipTaskbar": true,
        "shadow": false, "focus": false, "visibleOnAllWorkspaces": true
      },
      {
        "label": "bar", "url": "bar.html", "title": "Ask Ultron",
        "width": 680, "height": 360, "resizable": false, "decorations": false,
        "transparent": true, "alwaysOnTop": true, "skipTaskbar": true,
        "shadow": false, "visible": false, "visibleOnAllWorkspaces": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
